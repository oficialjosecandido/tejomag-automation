{
  "routes": [
    {
      "route": "/sitemap",
      "rewrite": "/index.html",
      "statusCode": 200
    },
    {
      "route": "/sitemap2",
      "rewrite": "/sitemap2.xml",
      "statusCode": 200,
      "headers": {
        "Content-Type": "application/xml; charset=utf-8"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*.{png,jpg,gif}", "/static/*", "*.xml", "/robots.txt", "/ads.txt", "/sitemap", "/sitemap2"]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  }
}

